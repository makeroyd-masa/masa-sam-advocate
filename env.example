# Copy to .env and adjust. .env is gitignored.

# Read-only reference DB produced by the separate `medical_billing_data` repo.
# Build it there (python cli.py run-all) and point here, or use an absolute path.
PILOT_DB_PATH=./data/pilot.db

# The app's writable case/state DB. Create it from the schema:
#   sqlite3 "$APP_DB_PATH" < docs/app_schema_v0_1.sql
APP_DB_PATH=./app.db
